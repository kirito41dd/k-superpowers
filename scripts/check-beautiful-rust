#!/usr/bin/env bash
# Compare the last assessed revision with upstream. This check never advances it.
set -u

root=$(cd "$(dirname "$0")/.." && pwd) || exit 2
upstream=https://github.com/morganlinton/BeautifulRust
ref=refs/heads/main
reviewed=$(cat "$root/docs/upstreams/beautiful-rust.rev") || exit 2
if ! [[ $reviewed =~ ^[0-9a-f]{40}$ ]]; then
  echo 'Invalid reviewed commit in docs/upstreams/beautiful-rust.rev' >&2
  exit 2
fi

remote=$(git ls-remote --exit-code "$upstream.git" "$ref") || {
  echo "Could not resolve $ref at $upstream" >&2
  exit 2
}
head=${remote%%$'\t'*}
if ! [[ $head =~ ^[0-9a-f]{40}$ ]] || [[ $remote != "$head"$'\t'"$ref" ]]; then
  echo "Unexpected response for $ref" >&2
  exit 2
fi

if [[ $head == "$reviewed" ]]; then
  echo "BeautifulRust is up to date at $head"
  exit 0
fi
printf 'Reviewed: %s\nUpstream: %s\nCompare: %s/compare/%s...%s\n' \
  "$reviewed" "$head" "$upstream" "$reviewed" "$head"
exit 1
